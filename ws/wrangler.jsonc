{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pure-pets-wholesale",
  "main": "dist/preview-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [
    { "pattern": "pure-pets.net/ws*", "zone_name": "pure-pets.net" },
    { "pattern": "www.pure-pets.net/ws*", "zone_name": "pure-pets.net" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "FUNCTIONS_REGION": "us-central1",
    "FIREBASE_APPCHECK_SITE_KEY": "6Lc-j4wsAAAAAIiTp0_S9ZzMMPf4bnzx5WJ8Jtqy",
