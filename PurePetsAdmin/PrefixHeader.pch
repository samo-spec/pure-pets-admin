// ===== Error Handling =====
#define ShowError(err) do { \
    if (err) { \
        NSString *msg = [err localizedDescription] ?: @"Unknown error"; \
        dispatch_async(dispatch_get_main_queue(), ^{ \
            UIWindow *window = nil; \
            for (UIWindowScene *scene in UIApplication.sharedApplication.connectedScenes) { \
                if (scene.activationState == UISceneActivationStateForegroundActive) { \
                    window = scene.windows.firstObject; \
                    break; \
                } \
            } \
            if (!window) window = UIApplication.sharedApplication.windows.firstObject; \
            [PPAlertHelper showErrorIn:window.rootViewController title:kLang(@"Error") subtitle:msg]; \
        }); \
        DLog(@"❌ Error: %@", msg); \
    } \
} while (0)

static inline CGFloat StatusBarHeight(void) {
    CGFloat h = 0;
    if (@available(iOS 13.0, *)) {
        UIWindow *window = UIApplication.sharedApplication.windows.firstObject;
        UIStatusBarManager *m = window.windowScene.statusBarManager;
        h = m ? m.statusBarFrame.size.height : 0;
    } else {
        h = UIApplication.sharedApplication.statusBarFrame.size.height;
    }
    return h;
}

#define STATUS_BAR_HEIGHT ({ \
    CGFloat h = 0; \
    if (@available(iOS 13.0, *)) { \
        UIWindow *window = UIApplication.sharedApplication.windows.firstObject; \
        UIStatusBarManager *m = window.windowScene.statusBarManager; \
        h = m ? m.statusBarFrame.size.height : 0; \
    } else { \
        h = UIApplication.sharedApplication.statusBarFrame.size.height; \
    } \
    h; \
})

