+- (id<FIRListenerRegistration>)_listenAllUsersInternalOrderedBy:(NSString *)orderField
+                                                      ascending:(BOOL)ascending
+                                           includeMetadataChanges:(BOOL)includeMetadata
+                                                          queue:(dispatch_queue_t)callbackQueue
+                                                     wantDiffs:(BOOL)wantDiffs
+                                                      completion:(void(^)(NSArray<UserModel *> * _Nullable users,
+                                                                          NSArray<FIRDocumentChange *> * _Nullable changes,
+                                                                          FIRSnapshotMetadata * _Nullable metadata,
+                                                                          NSError * _Nullable error))completion
+{
+    NSParameterAssert(completion != nil);
+
+    DLog(@"[PERM_SUB_COLL] _listenAllUsersInternalOrderedBy ENTER | field=%@ asc=%d includeMetadata=%d wantDiffs=%d queue=%s",
+         orderField ?: @"<nil>", ascending, includeMetadata, wantDiffs, PPQueueLabel(callbackQueue));
+
+    FIRQuery *q = [self.class usersBaseQueryOrderedBy:orderField ascending:ascending];
+
+    void (^handle)(FIRQuerySnapshot * _Nullable, NSError * _Nullable) = ^(FIRQuerySnapshot * _Nullable snapshot, NSError * _Nullable error) {
+        if (error) {
+            DLog(@"[PERM_SUB_COLL] snapshotListener ERROR: %@", error.localizedDescription);
+            [self _deliverOnQueue:callbackQueue block:^{ completion(nil, nil, nil, error); }];
+            return;
+        }
+        if (!snapshot) {
+            DLog(@"[PERM_SUB_COLL] snapshotListener WARNING: snapshot is nil");
+            [self _deliverOnQueue:callbackQueue block:^{ completion(@[], @[], nil, nil); }];
+            return;
+        }
+
+        DLog(@"[PERM_SUB_COLL] snapshotListener START | docs=%lu changes=%lu fromCache=%d pendingWrites=%d",
+             (unsigned long)snapshot.documents.count,
+             (unsigned long)snapshot.documentChanges.count,
+             snapshot.metadata.isFromCache,
+             snapshot.metadata.hasPendingWrites);
+
+        CFAbsoluteTime t0 = CFAbsoluteTimeGetCurrent();
+        dispatch_queue_t workQ = dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0);
+
+        [self _parseUsersFromSnapshot:snapshot
+                                workQ:workQ
+                            completion:^(NSArray<UserModel *> *users) {
+            NSArray<FIRDocumentChange *> *changes = wantDiffs ? snapshot.documentChanges : @[];
+
+            CFAbsoluteTime parseMs = (CFAbsoluteTimeGetCurrent() - t0) * 1000.0;
+            DLog(@"[PERM_SUB_COLL] snapshotListener PARSED | users=%lu (%.2fms) deliverQueue=%s",
+                 (unsigned long)users.count, parseMs, PPQueueLabel(callbackQueue));
+
+            if (wantDiffs && changes.count) {
+                for (FIRDocumentChange *c in changes) {
+                    NSString *typeStr = c.type == FIRDocumentChangeTypeAdded ? @"ADDED" :
+                                        c.type == FIRDocumentChangeTypeModified ? @"MODIFIED" : @"REMOVED";
+                    DLog(@"[PERM_SUB_COLL] change %@ | old=%ld new=%ld docID=%@",
+                         typeStr, (long)c.oldIndex, (long)c.newIndex, c.document.documentID);
+                }
+            }
+
+            [self _deliverOnQueue:callbackQueue block:^{
+                DLog(@"[PERM_SUB_COLL] snapshotListener COMPLETE deliver");
+                completion(users, changes, snapshot.metadata, nil);
+            }];
+        }];
+    };
+
+    id<FIRListenerRegistration> reg = includeMetadata
+        ? [q addSnapshotListenerWithIncludeMetadataChanges:YES listener:handle]
+        : [q addSnapshotListener:handle];
+
+    DLog(@"[PERM_SUB_COLL] _listenAllUsersInternalOrderedBy ATTACHED listener");
+    return reg;
+}
