++ (FIRQuery *)usersBaseQueryOrderedBy:(NSString * _Nullable)orderField
+                            ascending:(BOOL)ascending
+{
+    FIRFirestore *db = [FIRFirestore firestore];
+    FIRCollectionReference *col = [db collectionWithPath:kFUUsersCollection];
+
+    NSString *field = orderField.length ? orderField : @"UserName";
+    DLog(@"[PERM_SUB_COLL] usersBaseQueryOrderedBy | field=%@ asc=%d", field, ascending);
